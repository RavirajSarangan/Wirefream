"use client"
import React, { useState } from 'react'
import { FileText, Download, RefreshCw, Sparkles } from 'lucide-react'
import { useAuthContext } from '@/app/provider'
import { storage } from '@/configs/firebaseConfig'
import { getDownloadURL, ref, uploadBytes } from 'firebase/storage'

// SEO Metadata would go in a server component wrapper
import { Button } from '@/components/ui/button'
import { Input } from '@/components/ui/input'
import { Textarea } from '@/components/ui/textarea'
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select'
import { toast } from 'sonner'

type CreationMode = 'manual' | 'prompt'

// Generate unique ID
const generateUID = () => {
  return Date.now().toString(36) + Math.random().toString(36).substring(2);
};

function CoverPageCreator() {
    const { user } = useAuthContext()
    const [mode, setMode] = useState<CreationMode>('manual')
    const [formData, setFormData] = useState({
        institutionName: '',
        title: '',
        subject: '',
        studentName: '',
        indexNumber: '',
        className: '',
        teacherName: '',
        date: new Date().toISOString().split('T')[0]
    })

    const [promptText, setPromptText] = useState('')
    const [generatingFromPrompt, setGeneratingFromPrompt] = useState(false)
    const [template, setTemplate] = useState('classic')
    const [pageSize, setPageSize] = useState('a4')
    const [aiModel, setAiModel] = useState('gemini')
    const [uploadedImage, setUploadedImage] = useState<string | null>(null)
    const [generating, setGenerating] = useState(false)

    const templates = [
        { value: 'classic', label: 'Classic', category: 'Academic' },
        { value: 'modern', label: 'Modern', category: 'Business' },
        { value: 'minimal', label: 'Minimal', category: 'Academic' },
        { value: 'formal', label: 'Formal', category: 'Research' },
        { value: 'creative', label: 'Creative', category: 'Portfolio' },
        { value: 'professional', label: 'Professional', category: 'Business' }
    ]

    const pageSizes = [
        { value: 'a4', label: 'A4 (210 × 297 mm)', width: 210, height: 297, ratio: 1.414 },
        { value: 'letter', label: 'Letter (8.5 × 11")', width: 215.9, height: 279.4, ratio: 1.294 },
        { value: 'legal', label: 'Legal (8.5 × 14")', width: 215.9, height: 355.6, ratio: 1.647 },
        { value: 'a3', label: 'A3 (297 × 420 mm)', width: 297, height: 420, ratio: 1.414 }
    ]

    const aiModels = [
        { value: 'gemini', label: 'Gemini', provider: 'Google' },
        { value: 'chatgpt', label: 'ChatGPT', provider: 'OpenAI' },
        { value: 'claude', label: 'Claude', provider: 'Anthropic' },
        { value: 'custom', label: 'Custom AI', provider: 'Other' }
    ]

    const handleInputChange = (field: string, value: string) => {
        setFormData(prev => ({ ...prev, [field]: value }))
    }

    const handleImageUpload = (e: React.ChangeEvent<HTMLInputElement>) => {
        const file = e.target.files?.[0]
        if (file) {
            if (file.size > 5 * 1024 * 1024) {
                toast.error('Image size should be less than 5MB')
                return
            }
            const reader = new FileReader()
            reader.onloadend = () => {
                setUploadedImage(reader.result as string)
                toast.success('Image uploaded successfully')
            }
            reader.readAsDataURL(file)
        }
    }

    const getAIModelIcon = () => {
        if (aiModel === 'gemini') {
            return (
                <svg viewBox="0 0 24 24" className="w-6 h-6">
                    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                    <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                </svg>
            )
        }
        return null
    }

    const selectedPageSize = pageSizes.find(ps => ps.value === pageSize)
    const selectedAIModel = aiModels.find(am => am.value === aiModel)

    const generateFromPrompt = async () => {
        if (!promptText.trim()) {
            toast.error('Please enter a description for your cover page')
            return
        }

        setGeneratingFromPrompt(true)
        toast.info('AI is analyzing your description...')
        
        try {
            const response = await fetch('/api/generate-cover-page', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    prompt: promptText,
                    model: aiModel
                })
            })

            if (!response.ok) {
                throw new Error('Failed to generate cover page')
            }

            const data = await response.json()
            
            if (data.error) {
                throw new Error(data.error)
            }

            // Update form data with AI-extracted information
            setFormData({
                institutionName: data.institutionName,
                title: data.title,
                subject: data.subject,
                studentName: data.studentName,
                indexNumber: data.indexNumber,
                className: data.className,
                teacherName: data.teacherName,
                date: new Date().toISOString().split('T')[0]
            })

            // Update template if AI suggested one
            if (data.template) {
                setTemplate(data.template)
            }
            
            setMode('manual')
            setGeneratingFromPrompt(false)
            toast.success('Cover page generated! You can now customize it.')
        } catch (error: any) {
            console.error('Error generating cover page:', error)
            setGeneratingFromPrompt(false)
            toast.error(error.message || 'Failed to generate cover page. Please try again.')
        }
    }

    const generatePDF = async () => {
        if (!formData.institutionName || !formData.title || !formData.studentName) {
            toast.error('Please fill in required fields (Institution, Title, Name)')
            return
        }

        setGenerating(true)
        toast.info('Generating PDF...')
        
        try {
            // Dynamic import to avoid SSR issues
            const jsPDF = (await import('jspdf')).default
            const doc = new jsPDF({
                orientation: 'portrait',
                unit: 'mm',
                format: pageSize === 'a4' ? 'a4' : pageSize === 'letter' ? 'letter' : 'a4'
            })

            const pageWidth = doc.internal.pageSize.getWidth()
            const pageHeight = doc.internal.pageSize.getHeight()
            const margin = 20

            // Add border for classic and formal templates
            if (template === 'classic' || template === 'formal') {
                doc.setLineWidth(1)
                doc.rect(15, 15, pageWidth - 30, pageHeight - 30)
                if (template === 'formal') {
                    doc.setLineWidth(0.5)
                    doc.rect(17, 17, pageWidth - 34, pageHeight - 34)
                }
            }

            // Add logo if uploaded
            if (uploadedImage) {
                try {
                    doc.addImage(uploadedImage, 'PNG', pageWidth / 2 - 15, 30, 30, 30)
                } catch (e) {
                    console.log('Could not add image to PDF')
                }
            }

            // Institution Name
            doc.setFontSize(template === 'creative' ? 22 : 20)
            doc.setFont('helvetica', 'bold')
            const institutionY = uploadedImage ? 70 : 40
            const institutionLines = doc.splitTextToSize(formData.institutionName, pageWidth - 2 * margin)
            doc.text(institutionLines, pageWidth / 2, institutionY, { align: 'center' })

            // Underline for classic/formal
            if (template === 'classic' || template === 'formal') {
                const textWidth = doc.getTextWidth(formData.institutionName)
                const lineY = institutionY + 5
                doc.line(pageWidth / 2 - textWidth / 2, lineY, pageWidth / 2 + textWidth / 2, lineY)
            }

            // Document Title
            doc.setFontSize(template === 'creative' ? 18 : 16)
            doc.setFont('helvetica', 'bold')
            const titleY = institutionY + 40
            const titleLines = doc.splitTextToSize(formData.title, pageWidth - 2 * margin)
            doc.text(titleLines, pageWidth / 2, titleY, { align: 'center' })

            // Subject
            if (formData.subject) {
                doc.setFontSize(12)
                doc.setFont('helvetica', template === 'formal' ? 'italic' : 'normal')
                doc.text(formData.subject, pageWidth / 2, titleY + 15, { align: 'center' })
            }

            // Student Information Section
            const studentSectionY = pageHeight / 2 + 10
            doc.setFontSize(11)
            doc.setFont('helvetica', 'normal')
            doc.text('Submitted By:', pageWidth / 2, studentSectionY, { align: 'center' })

            doc.setFontSize(14)
            doc.setFont('helvetica', 'bold')
            doc.text(formData.studentName, pageWidth / 2, studentSectionY + 10, { align: 'center' })

            let currentY = studentSectionY + 20
            doc.setFontSize(11)
            doc.setFont('helvetica', 'normal')

            if (formData.indexNumber) {
                doc.text(`Index Number: ${formData.indexNumber}`, pageWidth / 2, currentY, { align: 'center' })
                currentY += 7
            }

            if (formData.className) {
                doc.text(`Class: ${formData.className}`, pageWidth / 2, currentY, { align: 'center' })
                currentY += 7
            }

            // Teacher Information
            if (formData.teacherName) {
                currentY += 10
                doc.setFont('helvetica', 'normal')
                doc.text('Submitted To:', pageWidth / 2, currentY, { align: 'center' })
                
                doc.setFont('helvetica', 'bold')
                doc.text(formData.teacherName, pageWidth / 2, currentY + 7, { align: 'center' })
            }

            // Date at bottom
            doc.setFontSize(10)
            doc.setFont('helvetica', 'normal')
            const formattedDate = new Date(formData.date).toLocaleDateString('en-US', { 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric' 
            })
            doc.text(`Date: ${formattedDate}`, pageWidth / 2, pageHeight - 30, { align: 'center' })

            // AI Model attribution
            const selectedModel = aiModels.find(am => am.value === aiModel)
            doc.setFontSize(8)
            doc.setTextColor(128, 128, 128)
            doc.text(`Powered by ${selectedModel?.label || 'AI'}`, pageWidth / 2, pageHeight - 20, { align: 'center' })

            // Save to database
            try {
                let logoUrl = ''
                
                // Upload logo to Firebase if exists
                if (uploadedImage && user?.email) {
                    const logoFileName = `${Date.now()}_logo.png`
                    const logoRef = ref(storage, `CoverPageLogos/${logoFileName}`)
                    
                    // Convert base64 to blob
                    const response = await fetch(uploadedImage)
                    const blob = await response.blob()
                    
                    await uploadBytes(logoRef, blob)
                    logoUrl = await getDownloadURL(logoRef)
                }

                const uid = generateUID()
                
                await fetch('/api/cover-page', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        uid,
                        institutionName: formData.institutionName,
                        title: formData.title,
                        subject: formData.subject,
                        studentName: formData.studentName,
                        indexNumber: formData.indexNumber,
                        className: formData.className,
                        teacherName: formData.teacherName,
                        date: formData.date,
                        template,
                        pageSize,
                        logoUrl,
                        aiModel,
                        generationMethod: mode,
                        originalPrompt: mode === 'prompt' ? promptText : '',
                        email: user?.email
                    })
                })
            } catch (dbError) {
                console.error('Failed to save to database:', dbError)
                // Continue with PDF download even if database save fails
            }

            // Save PDF
            const fileName = `${formData.title.replace(/[^a-z0-9]/gi, '_')}_CoverPage.pdf`
            doc.save(fileName)
            
            setGenerating(false)
            toast.success('PDF downloaded successfully!')
        } catch (error: any) {
            console.error('Error generating PDF:', error)
            setGenerating(false)
            toast.error('Failed to generate PDF. Please try again.')
        }
    }

    return (
        <div className='xl:px-20'>
            <div className='flex items-center justify-between mb-6'>
                <div>
                    <div className='flex items-center gap-3'>
                        <FileText className='h-8 w-8 text-indigo-600' />
                        <h2 className='font-bold text-3xl'>Cover Page Creator</h2>
                    </div>
                    <p className='text-gray-500 mt-1'>Create professional cover pages - Choose your creation method</p>
                </div>
            </div>

            {/* Mode Selection Tabs */}
            <div className='bg-white rounded-xl border-2 border-gray-200 p-2 mb-6 flex gap-2'>
                <button
                    onClick={() => setMode('manual')}
                    className={`flex-1 flex items-center justify-center gap-2 py-3 px-4 rounded-lg font-semibold transition-all ${
                        mode === 'manual' 
                            ? 'bg-indigo-600 text-white shadow-md' 
                            : 'bg-gray-50 text-gray-600 hover:bg-gray-100'
                    }`}
                >
                    <FileText className='h-5 w-5' />
                    Manual Entry
                </button>
                <button
                    onClick={() => setMode('prompt')}
                    className={`flex-1 flex items-center justify-center gap-2 py-3 px-4 rounded-lg font-semibold transition-all ${
                        mode === 'prompt' 
                            ? 'bg-gradient-to-r from-purple-600 to-pink-600 text-white shadow-md' 
                            : 'bg-gray-50 text-gray-600 hover:bg-gray-100'
                    }`}
                >
                    <Sparkles className='h-5 w-5' />
                    AI Prompt (Canva Style)
                </button>
            </div>

            {/* AI Prompt Mode */}
            {mode === 'prompt' && (
                <div className='grid grid-cols-1 lg:grid-cols-2 gap-8'>
                    <div className='bg-gradient-to-br from-purple-50 to-pink-50 p-6 rounded-xl border-2 border-purple-200'>
                        <div className='flex items-center gap-3 mb-4'>
                            <div className='p-2 bg-gradient-to-r from-purple-600 to-pink-600 rounded-lg'>
                                <Sparkles className='h-5 w-5 text-white' />
                            </div>
                            <h3 className='font-semibold text-lg'>AI-Powered Cover Page Generator</h3>
                        </div>
                        
                        <p className='text-sm text-gray-600 mb-4'>
                            Describe your cover page in natural language, just like you would on Canva. 
                            Our AI will automatically generate a beautiful cover page for you!
                        </p>

                        <div className='space-y-4'>
                            <div>
                                <label htmlFor='promptInput' className='text-sm font-medium mb-2 block'>
                                    Describe Your Cover Page
                                </label>
                                <Textarea
                                    id='promptInput'
                                    placeholder='Example: Create a cover page for my Computer Science project titled "Machine Learning Applications". The institution is MIT, student name is John Doe with ID CS2025001, and the teacher is Prof. Sarah Johnson. Make it modern and professional with blue theme.'
                                    value={promptText}
                                    onChange={(e) => setPromptText(e.target.value)}
                                    className='min-h-[200px] bg-white'
                                />
                                <p className='text-xs text-gray-500 mt-2'>
                                    💡 Tip: Include institution name, document title, your name, ID, class, teacher name, and any style preferences
                                </p>
                            </div>

                            <div>
                                <label htmlFor='aiModelPrompt' className='text-sm font-medium mb-2 block'>AI Model</label>
                                <Select value={aiModel} onValueChange={setAiModel}>
                                    <SelectTrigger id='aiModelPrompt'>
                                        <SelectValue />
                                    </SelectTrigger>
                                    <SelectContent>
                                        {aiModels.map((am) => (
                                            <SelectItem key={am.value} value={am.value}>
                                                {am.label} <span className='text-xs text-gray-500'>({am.provider})</span>
                                            </SelectItem>
                                        ))}
                                    </SelectContent>
                                </Select>
                            </div>

                            <Button
                                onClick={generateFromPrompt}
                                disabled={generatingFromPrompt}
                                className='w-full bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700'
                            >
                                {generatingFromPrompt ? (
                                    <>
                                        <RefreshCw className='mr-2 h-4 w-4 animate-spin' />
                                        Generating with AI...
                                    </>
                                ) : (
                                    <>
                                        <Sparkles className='mr-2 h-4 w-4' />
                                        Generate Cover Page
                                    </>
                                )}
                            </Button>
                        </div>

                        <div className='mt-6 p-4 bg-white rounded-lg border border-purple-200'>
                            <h4 className='font-semibold text-sm mb-2 text-purple-800'>Example Prompts:</h4>
                            <ul className='space-y-2 text-xs text-gray-600'>
                                <li className='flex items-start gap-2'>
                                    <span className='text-purple-600 mt-0.5'>•</span>
                                    <span>&quot;Create a formal cover page for Harvard University, Physics Department project by Emily Watson, ID: PH2025042&quot;</span>
                                </li>
                                <li className='flex items-start gap-2'>
                                    <span className='text-purple-600 mt-0.5'>•</span>
                                    <span>&quot;Make a creative cover page for my Design class portfolio, student Alex Chen, submitted to Prof. Lisa Brown&quot;</span>
                                </li>
                                <li className='flex items-start gap-2'>
                                    <span className='text-purple-600 mt-0.5'>•</span>
                                    <span>&quot;Generate a minimal cover page for Stanford, Mathematics thesis, student Michael Lee, advisor Dr. Robert Kim&quot;</span>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div className='bg-white p-6 rounded-xl border-2 border-gray-200'>
                        <h3 className='font-semibold text-lg mb-4'>AI Preview</h3>
                        <div className='bg-gradient-to-br from-purple-50 to-pink-50 rounded-lg p-12 border-2 border-dashed border-purple-300 min-h-[600px] flex flex-col items-center justify-center text-center'>
                            {generatingFromPrompt ? (
                                <>
                                    <RefreshCw className='h-12 w-12 text-purple-600 animate-spin mb-4' />
                                    <p className='text-gray-600 font-medium'>AI is designing your cover page...</p>
                                    <p className='text-sm text-gray-500 mt-2'>This may take a few seconds</p>
                                </>
                            ) : promptText ? (
                                <>
                                    <Sparkles className='h-12 w-12 text-purple-600 mb-4' />
                                    <p className='text-gray-600 font-medium mb-2'>Ready to generate!</p>
                                    <p className='text-sm text-gray-500 max-w-md'>
                                        Click the &quot;Generate Cover Page&quot; button to let AI create your cover page from your description
                                    </p>
                                </>
                            ) : (
                                <>
                                    <FileText className='h-12 w-12 text-gray-300 mb-4' />
                                    <p className='text-gray-500 font-medium mb-2'>Enter your description</p>
                                    <p className='text-sm text-gray-400 max-w-md'>
                                        Describe your cover page in the text area, and our AI will generate it for you automatically
                                    </p>
                                </>
                            )}
                        </div>
                    </div>
                </div>
            )}

            {/* Manual Entry Mode */}
            {mode === 'manual' && (
                <div className='grid grid-cols-1 lg:grid-cols-2 gap-8'>
                    {/* Form Section */}
                    <div className='space-y-6'>
                        <div className='bg-white p-6 rounded-xl border-2 border-gray-200'>
                            <h3 className='font-semibold text-lg mb-4'>Cover Page Details</h3>
                            
                            <div className='space-y-4'>
                            <div>
                                <label htmlFor='institutionName' className='text-sm font-medium mb-1 block'>
                                    Institution Name <span className='text-red-500'>*</span>
                                </label>
                                <Input
                                    id='institutionName'
                                    placeholder='e.g., University of Technology'
                                    value={formData.institutionName}
                                    onChange={(e) => handleInputChange('institutionName', e.target.value)}
                                />
                            </div>

                            <div>
                                <label htmlFor='title' className='text-sm font-medium mb-1 block'>
                                    Document Title <span className='text-red-500'>*</span>
                                </label>
                                <Input
                                    id='title'
                                    placeholder='e.g., Research Project Report'
                                    value={formData.title}
                                    onChange={(e) => handleInputChange('title', e.target.value)}
                                />
                            </div>

                            <div>
                                <label htmlFor='subject' className='text-sm font-medium mb-1 block'>Subject</label>
                                <Input
                                    id='subject'
                                    placeholder='e.g., Computer Science'
                                    value={formData.subject}
                                    onChange={(e) => handleInputChange('subject', e.target.value)}
                                />
                            </div>

                            <div>
                                <label htmlFor='studentName' className='text-sm font-medium mb-1 block'>
                                    Student Name <span className='text-red-500'>*</span>
                                </label>
                                <Input
                                    id='studentName'
                                    placeholder='e.g., John Doe'
                                    value={formData.studentName}
                                    onChange={(e) => handleInputChange('studentName', e.target.value)}
                                />
                            </div>

                            <div className='grid grid-cols-2 gap-4'>
                                <div>
                                    <label htmlFor='indexNumber' className='text-sm font-medium mb-1 block'>Index Number</label>
                                    <Input
                                        id='indexNumber'
                                        placeholder='e.g., 2025/CS/001'
                                        value={formData.indexNumber}
                                        onChange={(e) => handleInputChange('indexNumber', e.target.value)}
                                    />
                                </div>

                                <div>
                                    <label htmlFor='className' className='text-sm font-medium mb-1 block'>Class/Year</label>
                                    <Input
                                        id='className'
                                        placeholder='e.g., 3rd Year'
                                        value={formData.className}
                                        onChange={(e) => handleInputChange('className', e.target.value)}
                                    />
                                </div>
                            </div>

                            <div>
                                <label htmlFor='teacherName' className='text-sm font-medium mb-1 block'>Teacher/Professor Name</label>
                                <Input
                                    id='teacherName'
                                    placeholder='e.g., Dr. Jane Smith'
                                    value={formData.teacherName}
                                    onChange={(e) => handleInputChange('teacherName', e.target.value)}
                                />
                            </div>

                            <div>
                                <label htmlFor='date' className='text-sm font-medium mb-1 block'>Date</label>
                                <Input
                                    id='date'
                                    type='date'
                                    value={formData.date}
                                    onChange={(e) => handleInputChange('date', e.target.value)}
                                />
                            </div>

                            <div>
                                <label htmlFor='template' className='text-sm font-medium mb-1 block'>Template Style</label>
                                <Select value={template} onValueChange={setTemplate}>
                                    <SelectTrigger id='template'>
                                        <SelectValue />
                                    </SelectTrigger>
                                    <SelectContent>
                                        {templates.map((t) => (
                                            <SelectItem key={t.value} value={t.value}>
                                                {t.label} <span className='text-xs text-gray-500'>({t.category})</span>
                                            </SelectItem>
                                        ))}
                                    </SelectContent>
                                </Select>
                            </div>

                            <div>
                                <label htmlFor='pageSize' className='text-sm font-medium mb-1 block'>Page Size</label>
                                <Select value={pageSize} onValueChange={setPageSize}>
                                    <SelectTrigger id='pageSize'>
                                        <SelectValue />
                                    </SelectTrigger>
                                    <SelectContent>
                                        {pageSizes.map((ps) => (
                                            <SelectItem key={ps.value} value={ps.value}>
                                                {ps.label}
                                            </SelectItem>
                                        ))}
                                    </SelectContent>
                                </Select>
                            </div>

                            <div>
                                <label htmlFor='aiModel' className='text-sm font-medium mb-1 block'>AI Model Used</label>
                                <Select value={aiModel} onValueChange={setAiModel}>
                                    <SelectTrigger id='aiModel'>
                                        <SelectValue />
                                    </SelectTrigger>
                                    <SelectContent>
                                        {aiModels.map((am) => (
                                            <SelectItem key={am.value} value={am.value}>
                                                {am.label} <span className='text-xs text-gray-500'>({am.provider})</span>
                                            </SelectItem>
                                        ))}
                                    </SelectContent>
                                </Select>
                            </div>

                            <div>
                                <label htmlFor='uploadImage' className='text-sm font-medium mb-1 block'>Upload Logo/Image (Optional)</label>
                                <div className='flex items-center gap-2'>
                                    <Input
                                        id='uploadImage'
                                        type='file'
                                        accept='image/*'
                                        onChange={handleImageUpload}
                                        className='cursor-pointer'
                                    />
                                    {uploadedImage && (
                                        <Button
                                            variant='outline'
                                            size='sm'
                                            onClick={() => setUploadedImage(null)}
                                        >
                                            Remove
                                        </Button>
                                    )}
                                </div>
                                {uploadedImage && (
                                    <div className='mt-2 relative w-20 h-20 border rounded'>
                                        <img src={uploadedImage} alt='Uploaded' className='w-full h-full object-cover rounded' />
                                    </div>
                                )}
                            </div>
                        </div>

                        <div className='mt-6'>
                            <Button
                                onClick={generatePDF}
                                disabled={generating}
                                className='w-full bg-indigo-600 hover:bg-indigo-700'
                            >
                                {generating ? (
                                    <>
                                        <RefreshCw className='mr-2 h-4 w-4 animate-spin' />
                                        Generating...
                                    </>
                                ) : (
                                    <>
                                        <Download className='mr-2 h-4 w-4' />
                                        Generate Cover Page
                                    </>
                                )}
                            </Button>
                            </div>
                        </div>
                    </div>

                    {/* Preview Section */}
                    <div className='bg-white p-6 rounded-xl border-2 border-gray-200'>
                    <div className='flex items-center justify-between mb-4'>
                        <h3 className='font-semibold text-lg'>Preview - {template.charAt(0).toUpperCase() + template.slice(1)} Template</h3>
                        <div className='text-xs text-gray-500'>
                            {selectedPageSize?.label}
                        </div>
                    </div>
                    <div 
                        className='bg-gray-50 rounded-lg p-8 border-2 border-gray-300 flex flex-col justify-between overflow-auto'
                        style={{
                            minHeight: `${selectedPageSize ? selectedPageSize.ratio * 400 : 600}px`,
                            maxHeight: '700px'
                        }}
                    >
                        {template === 'classic' && (
                            <div className='border-4 border-gray-800 p-6 h-full flex flex-col justify-between'>
                                <div>
                                    {uploadedImage && (
                                        <div className='flex justify-center mb-4'>
                                            <img src={uploadedImage} alt='Logo' className='h-16 w-16 object-contain' />
                                        </div>
                                    )}
                                    <h2 className='text-2xl font-bold text-center mb-4 border-b-2 border-gray-800 pb-2'>
                                        {formData.institutionName || 'Institution Name'}
                                    </h2>
                                </div>
                                <div className='text-center flex-1 flex flex-col justify-center'>
                                    <h3 className='text-xl font-bold mb-4'>{formData.title || 'Document Title'}</h3>
                                    {formData.subject && <p className='text-sm mb-6'>Subject: {formData.subject}</p>}
                                    <div className='space-y-2 text-sm'>
                                        <p className='font-semibold'>Submitted By:</p>
                                        <p className='font-bold'>{formData.studentName || 'Student Name'}</p>
                                        {formData.indexNumber && <p>Index No: {formData.indexNumber}</p>}
                                        {formData.className && <p>Class: {formData.className}</p>}
                                    </div>
                                    {formData.teacherName && (
                                        <div className='mt-4 space-y-1 text-sm'>
                                            <p className='font-semibold'>Submitted To:</p>
                                            <p className='font-bold'>{formData.teacherName}</p>
                                        </div>
                                    )}
                                </div>
                                <div className='text-center'>
                                    <p className='text-sm mb-2'>Date: {new Date(formData.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
                                    <div className='flex items-center justify-center gap-2 text-xs text-gray-600 mt-3'>
                                        {getAIModelIcon()}
                                        <span>Powered by {selectedAIModel?.label}</span>
                                    </div>
                                </div>
                            </div>
                        )}

                        {template === 'modern' && (
                            <div className='h-full flex flex-col'>
                                <div className='bg-blue-600 text-white p-4 rounded-t-lg text-center'>
                                    {uploadedImage && (
                                        <div className='flex justify-center mb-2'>
                                            <img src={uploadedImage} alt='Logo' className='h-12 w-12 object-contain' />
                                        </div>
                                    )}
                                    <h2 className='text-2xl font-bold'>{formData.institutionName || 'Institution Name'}</h2>
                                </div>
                                <div className='flex-1 p-6 flex flex-col justify-center'>
                                    <h3 className='text-xl font-bold text-center mb-2'>{formData.title || 'Document Title'}</h3>
                                    {formData.subject && <p className='text-sm text-center italic mb-6'>{formData.subject}</p>}
                                    <div className='bg-gray-100 rounded-lg p-4 mb-4'>
                                        <p className='text-sm font-semibold mb-2'>Submitted By:</p>
                                        <p className='font-bold text-lg'>{formData.studentName || 'Student Name'}</p>
                                        {formData.indexNumber && <p className='text-sm'>Index: {formData.indexNumber}</p>}
                                        {formData.className && <p className='text-sm'>Class: {formData.className}</p>}
                                    </div>
                                    {formData.teacherName && (
                                        <div className='text-sm'>
                                            <p className='font-semibold'>Submitted To:</p>
                                            <p className='font-bold'>{formData.teacherName}</p>
                                        </div>
                                    )}
                                </div>
                                <div className='text-center pb-4'>
                                    <p className='text-xs mb-2'>{new Date(formData.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
                                    <div className='flex items-center justify-center gap-2 text-xs text-gray-600'>
                                        {getAIModelIcon()}
                                        <span>Powered by {selectedAIModel?.label}</span>
                                    </div>
                                </div>
                            </div>
                        )}

                        {template === 'minimal' && (
                            <div className='h-full flex flex-col justify-between py-8'>
                                <div className='text-center'>
                                    {uploadedImage && (
                                        <div className='flex justify-center mb-3'>
                                            <img src={uploadedImage} alt='Logo' className='h-14 w-14 object-contain' />
                                        </div>
                                    )}
                                    <h2 className='text-xl font-bold mb-2'>{formData.institutionName || 'Institution Name'}</h2>
                                    <div className='w-3/4 mx-auto border-b border-gray-400 mb-12'></div>
                                </div>
                                <div className='text-center flex-1 flex flex-col justify-center space-y-4'>
                                    <h3 className='text-lg font-bold'>{formData.title || 'Document Title'}</h3>
                                    {formData.subject && <p className='text-sm'>{formData.subject}</p>}
                                    <p className='text-sm'>{formData.studentName || 'Student Name'}</p>
                                    {formData.indexNumber && <p className='text-xs'>{formData.indexNumber}</p>}
                                    {formData.teacherName && <p className='text-sm'>Prof. {formData.teacherName}</p>}
                                </div>
                                <div className='text-center'>
                                    <p className='text-xs mb-2'>{new Date(formData.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
                                    <div className='flex items-center justify-center gap-2 text-xs text-gray-600'>
                                        {getAIModelIcon()}
                                        <span>Powered by {selectedAIModel?.label}</span>
                                    </div>
                                </div>
                            </div>
                        )}

                        {template === 'formal' && (
                            <div className='border-2 border-gray-800 p-6 h-full flex flex-col justify-between'>
                                <div className='text-center'>
                                    {uploadedImage && (
                                        <div className='flex justify-center mb-3'>
                                            <img src={uploadedImage} alt='Logo' className='h-16 w-16 object-contain' />
                                        </div>
                                    )}
                                    <h2 className='text-xl font-bold mb-2'>{formData.institutionName || 'Institution Name'}</h2>
                                    <div className='border-t-2 border-double border-gray-800 w-3/4 mx-auto mb-8'></div>
                                </div>
                                <div className='text-center flex-1 flex flex-col justify-center space-y-4'>
                                    <h3 className='text-lg italic font-bold'>{formData.title || 'Document Title'}</h3>
                                    {formData.subject && <p className='text-sm'>[{formData.subject}]</p>}
                                    <div className='mt-6 space-y-2 text-sm'>
                                        <p>Prepared by:</p>
                                        <p className='font-bold'>{formData.studentName || 'Student Name'}</p>
                                        {formData.indexNumber && <p>Registration No: {formData.indexNumber}</p>}
                                    </div>
                                    {formData.teacherName && (
                                        <div className='mt-4 space-y-2 text-sm'>
                                            <p>Under the guidance of:</p>
                                            <p className='font-bold'>{formData.teacherName}</p>
                                        </div>
                                    )}
                                </div>
                                <div className='text-center'>
                                    <p className='text-xs mb-2'>{new Date(formData.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
                                    <div className='flex items-center justify-center gap-2 text-xs text-gray-600'>
                                        {getAIModelIcon()}
                                        <span>Powered by {selectedAIModel?.label}</span>
                                    </div>
                                </div>
                            </div>
                        )}

                        {template === 'creative' && (
                            <div className='h-full flex flex-col bg-gradient-to-br from-purple-50 to-pink-50'>
                                <div className='bg-gradient-to-r from-purple-600 to-pink-600 text-white p-4 rounded-b-3xl text-center'>
                                    {uploadedImage && (
                                        <div className='flex justify-center mb-2'>
                                            <img src={uploadedImage} alt='Logo' className='h-14 w-14 object-contain rounded-full bg-white p-1' />
                                        </div>
                                    )}
                                    <h2 className='text-2xl font-bold'>{formData.institutionName || 'Institution Name'}</h2>
                                </div>
                                <div className='flex-1 p-6 flex flex-col justify-center'>
                                    <div className='bg-white rounded-2xl shadow-lg p-6 space-y-4'>
                                        <h3 className='text-xl font-bold text-center bg-gradient-to-r from-purple-600 to-pink-600 bg-clip-text text-transparent'>
                                            {formData.title || 'Document Title'}
                                        </h3>
                                        {formData.subject && (
                                            <p className='text-sm text-center text-gray-600 italic'>{formData.subject}</p>
                                        )}
                                        <div className='bg-gradient-to-r from-purple-100 to-pink-100 rounded-xl p-4'>
                                            <p className='text-sm font-semibold mb-2 text-purple-800'>Created by:</p>
                                            <p className='font-bold text-lg text-purple-900'>{formData.studentName || 'Student Name'}</p>
                                            {formData.indexNumber && <p className='text-sm text-purple-700'>ID: {formData.indexNumber}</p>}
                                            {formData.className && <p className='text-sm text-purple-700'>{formData.className}</p>}
                                        </div>
                                        {formData.teacherName && (
                                            <div className='text-sm text-center'>
                                                <p className='font-semibold text-gray-700'>Instructor:</p>
                                                <p className='font-bold text-purple-800'>{formData.teacherName}</p>
                                            </div>
                                        )}
                                    </div>
                                </div>
                                <div className='text-center pb-4'>
                                    <p className='text-xs mb-2'>{new Date(formData.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
                                    <div className='flex items-center justify-center gap-2 text-xs text-gray-600'>
                                        {getAIModelIcon()}
                                        <span>Powered by {selectedAIModel?.label}</span>
                                    </div>
                                </div>
                            </div>
                        )}

                        {template === 'professional' && (
                            <div className='h-full flex flex-col bg-gray-50'>
                                <div className='bg-slate-800 text-white p-6 flex items-center gap-4'>
                                    {uploadedImage && (
                                        <img src={uploadedImage} alt='Logo' className='h-16 w-16 object-contain bg-white rounded p-1' />
                                    )}
                                    <div className='flex-1'>
                                        <h2 className='text-2xl font-bold'>{formData.institutionName || 'Institution Name'}</h2>
                                    </div>
                                </div>
                                <div className='flex-1 p-8 flex flex-col justify-center'>
                                    <div className='border-l-4 border-slate-800 pl-6 mb-8'>
                                        <h3 className='text-2xl font-bold text-slate-800 mb-2'>{formData.title || 'Document Title'}</h3>
                                        {formData.subject && (
                                            <p className='text-sm text-slate-600 uppercase tracking-wide'>{formData.subject}</p>
                                        )}
                                    </div>
                                    <div className='grid grid-cols-2 gap-6 text-sm'>
                                        <div className='space-y-2'>
                                            <p className='text-xs uppercase tracking-wide text-slate-500'>Author</p>
                                            <p className='font-bold text-slate-800'>{formData.studentName || 'Student Name'}</p>
                                            {formData.indexNumber && <p className='text-slate-600'>{formData.indexNumber}</p>}
                                            {formData.className && <p className='text-slate-600'>{formData.className}</p>}
                                        </div>
                                        {formData.teacherName && (
                                            <div className='space-y-2'>
                                                <p className='text-xs uppercase tracking-wide text-slate-500'>Supervisor</p>
                                                <p className='font-bold text-slate-800'>{formData.teacherName}</p>
                                            </div>
                                        )}
                                    </div>
                                </div>
                                <div className='bg-slate-100 p-4 text-center'>
                                    <p className='text-xs mb-2 text-slate-600'>
                                        {new Date(formData.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                                    </p>
                                    <div className='flex items-center justify-center gap-2 text-xs text-slate-500'>
                                        {getAIModelIcon()}
                                        <span>Powered by {selectedAIModel?.label}</span>
                                    </div>
                                </div>
                            </div>
                        )}
                    </div>
                </div>
            )}
        </div>
    )
}

export default CoverPageCreator
